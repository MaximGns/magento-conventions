<?xml version="1.0"?>
<ruleset name="PHPro Magento">
    <description>PHPro Magento coding standard. GrumPHP and a direct vendor/bin/phpcs run both use this file.</description>

    <rule ref="Magento2">
        <exclude name="Magento2.Functions.StaticFunction"/>
        <exclude name="Magento2.Exceptions.DirectThrow"/>
        <exclude name="Magento2.Exceptions.ThrowCatch"/>
        <exclude name="Magento2.Commenting.ClassAndInterfacePHPDocFormatting"/>
        <exclude name="Magento2.Commenting.ClassPropertyPHPDocFormatting"/>
        <exclude name="Magento2.Commenting.ConstantsPHPDocFormatting"/>
        <exclude name="Magento2.Annotation.MethodAnnotationStructure"/>
        <exclude name="Magento2.Annotation.MethodArguments"/>
    </rule>
    <rule ref="PSR2"/>

    <!-- Only check app/code: skip every path that is not app/code or below it. -->
    <exclude-pattern>^(?!.+/app/code(?:/.+)?$)</exclude-pattern>
    <exclude-pattern>*/Test/*</exclude-pattern>
    <exclude-pattern>*/Setup/Patch/Data/*</exclude-pattern>
    <exclude-pattern>*/Setup/Upgrade*</exclude-pattern>
    <exclude-pattern>*/Setup/Install*</exclude-pattern>
</ruleset>
